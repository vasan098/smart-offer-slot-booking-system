# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smartoffer
DATABASE_URL=Host=localhost;Port=5432;Database=smartoffer;Username=postgres;Password=postgres

# JWT (min 32 characters)
JWT_KEY=SmartOffer_SuperSecret_JWT_Key_Min32Chars!
JWT_ISSUER=SmartOfferSlotBooking
JWT_AUDIENCE=SmartOfferClients
JWT_EXPIRE_HOURS=24

# API
ASPNETCORE_URLS=http://localhost:5000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
VITE_API_URL=http://localhost:5000/api
